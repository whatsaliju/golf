# Baked hole assets are generated by `npm run bake` on a machine with open
# network egress. Keep the committed sample small; large DEM/imagery blobs
# for a full 18 can be regenerated, so they are ignored by default. Remove
# these lines if you want to commit baked assets for offline distribution.
public/holes/*/dem.bin
public/holes/*/sat.png
